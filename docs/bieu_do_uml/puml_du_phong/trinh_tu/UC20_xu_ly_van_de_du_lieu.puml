@startuml UC20_trinh_tu
' UC20 — Xử lý vấn đề dữ liệu
' API: GET /admin/issues; POST | DELETE /admin/issues/resolve
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Quản trị viên" as QT
boundary "UI_TrangQuanTri" as UI
control "Ctrl_QuanTriHeThong" as CTRL
entity "Ent_CoSoDuLieu" as DB
entity "Ent_NhatKy" as NK

QT -> UI : 1. Mở danh sách vấn đề
UI -> CTRL : 2. GET /admin/issues
CTRL -> DB : 3. Đọc vấn đề chưa xử lý
CTRL --> UI : 4. Danh sách vấn đề
QT -> UI : 5. Đánh dấu đã xử lý
UI -> CTRL : 6. POST /admin/issues/resolve
CTRL -> NK : 7. Ghi nhật ký
CTRL --> UI : 8. 200 OK
@enduml
