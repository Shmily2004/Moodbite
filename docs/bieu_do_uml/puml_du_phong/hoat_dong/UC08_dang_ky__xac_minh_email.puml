@startuml UC08_hoat_dong
' UC08 — Đăng ký (xác minh email)
' API: POST /api/v1/auth/register; POST /auth/verify-email/request; POST /auth/verify-email/confirm
skinparam shadowing false
start
|Khách hàng|
:Nhập tên đăng nhập, email và mật khẩu;
|Hệ thống|
:Kiểm tra định dạng và tên đăng nhập;
if (Tên đăng nhập đã có người dùng?) then (có)
  :Báo lỗi, yêu cầu chọn tên khác;
  stop
else (không)
  :Lưu tài khoản, cấp phiên, gửi thư xác minh kèm đường dẫn;
endif
|Khách hàng|
:Mở đường dẫn xác minh trong thư;
|Hệ thống|
:Kiểm tra đường dẫn xác minh;
if (Đường dẫn còn hạn và chưa dùng?) then (có)
  :Đánh dấu email đã xác minh;
else (không)
  :Báo đường dẫn không hợp lệ, cho gửi lại thư;
endif
stop
@enduml
