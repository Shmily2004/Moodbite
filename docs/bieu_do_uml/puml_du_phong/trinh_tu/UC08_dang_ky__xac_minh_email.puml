@startuml UC08_trinh_tu
' UC08 — Đăng ký (xác minh email)
' API: POST /api/v1/auth/register; POST /auth/verify-email/request; POST /auth/verify-email/confirm
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Khách" as KH
boundary "UI_GiaoDienWeb" as UI
control "Ctrl_HeThongXuLy" as CTRL
entity "Ent_CoSoDuLieu" as DB
entity "Ent_TaiKhoan" as TK

KH -> UI : 1. Nhập email, mật khẩu
UI -> CTRL : 2. POST /auth/register
CTRL -> TK : 3. Kiểm tra email chưa tồn tại, lưu tài khoản chưa xác minh
TK --> CTRL : 4. Đã lưu
CTRL -> TK : 5. Tạo mã xác minh
CTRL --> UI : 6. 201 Created, yêu cầu xác minh
UI --> KH : 7. Yêu cầu nhập mã xác minh email
KH -> UI : 8. Nhập mã từ email
UI -> CTRL : 9. POST /auth/verify-email/confirm
CTRL -> TK : 10. Đánh dấu email đã xác minh
CTRL --> UI : 11. 200 OK
UI --> KH : 12. Tài khoản đã kích hoạt
@enduml
