# Sao chép file này thành .env.local rồi điền giá trị thật.
# .env.local KHÔNG được commit (đã có trong .gitignore).

# Địa chỉ backend. Đổi thành URL thật khi deploy.
VITE_API_BASE=http://localhost:8001/api/v1

# Google Maps JavaScript API key.
# Để trống thì app vẫn chạy bình thường, chỉ là không hiện bản đồ.
#
# CẢNH BÁO: mọi biến VITE_* đều bị nhúng vào file build và ai cũng xem được.
# BẮT BUỘC giới hạn key theo tên miền (HTTP referrer) trong Google Cloud Console,
# nếu không người khác dùng key của bạn và bạn phải trả tiền.
# Hướng dẫn đầy đủ: docs/google_maps_integration.md
VITE_GOOGLE_MAPS_API_KEY=
