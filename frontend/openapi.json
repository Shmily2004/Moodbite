{
  "openapi": "3.1.0",
  "info": {
    "title": "MoodBite API",
    "description": "Gợi ý nhà hàng theo ngữ cảnh: câu tìm kiếm tự do + vị trí + thời điểm.\n\nMọi response bọc trong `data` (thành công) hoặc `error` (lỗi).\nXem GET /api/v1/health để biết nguồn dữ liệu nào đã sẵn sàng.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Tìm kiếm & xếp hạng nhà hàng",
        "description": "Nhận nhu cầu bằng ngôn ngữ tự nhiên kèm ràng buộc, trả danh sách đã xếp hạng.\n\nMỗi kết quả kèm `suggested_dish` (Lớp 5 của đề án) - gợi ý MÓN đi liền với quán, thay\nvì bắt client gọi thêm một endpoint khác và tự ghép hai danh sách.",
        "operationId": "search_api_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "RESTAURANT_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "DATA_NOT_READY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/restaurants/{restaurant_id}": {
      "get": {
        "tags": [
          "restaurants"
        ],
        "summary": "Restaurant Detail",
        "description": "Chi tiết 1 quán: giá, review thật, ảnh, không gian, giờ mở cửa.\n\n`restaurant_id` lấy từ field `restaurant_id` trong kết quả của POST /api/v1/search.\n\nQuán chưa cào được chi tiết trả 200 kèm `has_details: false` (KHÔNG phải 404) - quán\nvẫn tồn tại và vẫn được đề xuất, chỉ là chưa có dữ liệu bổ sung.",
        "operationId": "restaurant_detail_api_v1_restaurants__restaurant_id__get",
        "parameters": [
          {
            "name": "restaurant_id",
            "in": "path",
            "required": true,
