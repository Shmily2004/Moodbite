@startuml UC06_hoat_dong
' UC06 — Báo quán đã đóng cửa
' API: POST /api/v1/interactions {action_type: report_closed}
skinparam shadowing false
start
|Khách hàng|
:Bấm Báo đã đóng cửa;
|Hệ thống|
if (Đã đăng nhập?) then (có)
  |Hệ thống|
  :Ghi nhận lượt báo đóng cửa;
  :Ghi lượt báo, đưa quán vào hàng chờ quản trị;
  |Khách hàng|
  :Nhận thông báo đã ghi nhận;
  stop
else (không)
  :Chuyển tới trang đăng nhập;
  stop
endif
@enduml
