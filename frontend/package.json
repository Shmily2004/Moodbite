{
  "name": "moodbite-frontend",
  "private": true,
  "version": "0.3.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @moodbite/client",
    "dev:admin": "npm run dev --workspace @moodbite/admin",
    "build": "npm run build --workspace @moodbite/client && npm run build --workspace @moodbite/admin",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace @moodbite/client && npm run typecheck --workspace @moodbite/admin",
    "test": "npm run test --workspace @moodbite/client",
    "lint:arch": "steiger ./apps/client/src && steiger ./apps/admin/src",
    "gen:api": "openapi-typescript ./openapi.json -o ./packages/api-client/src/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "steiger": "^0.6.0",
    "typescript": "^5.7.2"
  }
}
