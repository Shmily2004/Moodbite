@startuml UC03_trinh_tu
' UC03 — Xem chi tiết món
' API: GET /api/v1/dishes/{id}  (song song với UC04)
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Khách" as KH
boundary "UI_GiaoDienWeb" as UI
control "Ctrl_HeThongXuLy" as CTRL
entity "Ent_CoSoDuLieu" as DB

KH -> UI : 1. Chọn một món
UI -> CTRL : 2. GET /dishes/{id}
CTRL -> DB : 3. Tra món theo id
DB --> CTRL : 4. Thông tin món + độ tin cậy gợi ý
CTRL --> UI : 5. Chi tiết món
UI --> KH : 6. Hiển thị giới thiệu món
@enduml
