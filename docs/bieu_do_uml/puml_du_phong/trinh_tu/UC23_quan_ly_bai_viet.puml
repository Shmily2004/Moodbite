@startuml UC23_trinh_tu
' UC23 — Quản lý bài viết
' API: /api/v1/admin/posts (GET, POST, PUT, DELETE)
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Quản trị viên" as QT
boundary "UI_TrangQuanTri" as UI
control "Ctrl_QuanTriHeThong" as CTRL
entity "Ent_CoSoDuLieu" as DB
entity "Ent_NhatKy" as NK

QT -> UI : 1. Soạn hoặc sửa bài
UI -> CTRL : 2. POST | PUT /admin/posts
CTRL -> DB : 3. Ghi bài (nháp hoặc công khai)
CTRL --> UI : 4. 200 OK
CTRL -> NK : 5. Ghi nhật ký
UI --> QT : 6. Hiển thị bài đã lưu
@enduml
