@startuml UC18_hoat_dong
' UC18 — Xem và sửa mô tả món
' API: GET /admin/dishes, GET/PATCH /admin/dishes/{id}
skinparam shadowing false
start
|Quản trị viên|
:Mở món, bấm Sửa mô tả;
:Nhập mô tả, bấm Lưu (hoặc Gỡ bản sửa);
|Hệ thống|
:PATCH /admin/dishes/{id};
if (Mô tả hợp lệ?) then (có)
  :Lưu bản sửa, ghi nhật ký;
else (không)
  :Trả lỗi 400, không ghi gì;
endif
|Quản trị viên|
:Xem mô tả mới;
stop
@enduml
