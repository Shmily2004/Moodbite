    "/api/v1/admin/restaurants": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List Restaurants",
        "description": "Danh sách quán cho trang quản trị.\n\nMẶC ĐỊNH có cả quán đã ẩn — khác với `/search` của người dùng cuối. Không có nó thì\nẩn xong sẽ không còn cách nào tìm lại để bỏ ẩn.",
        "operationId": "list_restaurants_api_v1_admin_restaurants_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Lọc theo tên, địa chỉ hoặc placeId",
              "title": "Q"
            },
            "description": "Lọc theo tên, địa chỉ hoặc placeId"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "include_hidden",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Có kèm quán đã ẩn hay không",
              "default": true,
              "title": "Include Hidden"
            },
            "description": "Có kèm quán đã ẩn hay không"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminRestaurantListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/restaurants/{restaurant_id}": {
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Update Restaurant",
        "description": "Sửa các trường mô tả của một quán.\n\n`exclude_unset=True`: chỉ gửi trường nào thì sửa trường đó. Nhờ vậy client phân biệt\nđược \"không đụng tới trường này\" với \"xoá giá trị của trường này\" (gửi `null`).",
        "operationId": "update_restaurant_api_v1_admin_restaurants__restaurant_id__patch",
        "parameters": [
          {
            "name": "restaurant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Restaurant Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUpdateRestaurantRequest"
              }
            }
          }
