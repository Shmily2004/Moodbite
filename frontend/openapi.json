  "components": {
    "schemas": {
      "ActionType": {
        "type": "string",
        "enum": [
          "view_detail",
          "get_directions",
          "save",
          "explicit_positive",
          "explicit_negative"
        ],
        "title": "ActionType"
      },
      "AdminLoginData": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Số giây token còn hiệu lực"
          }
        },
        "type": "object",
        "required": [
          "token",
          "expires_in"
        ],
        "title": "AdminLoginData"
      },
      "AdminLoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
