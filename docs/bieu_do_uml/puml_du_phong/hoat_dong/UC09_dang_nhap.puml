@startuml UC09_hoat_dong
' UC09 — Đăng nhập
' API: POST /api/v1/auth/login
skinparam shadowing false
start
|Khách|
:Nhập email và mật khẩu;
|Hệ thống|
:POST /auth/login;
if (Đúng mật khẩu và đã xác minh?) then (có)
  :Tạo phiên đăng nhập;
else (không)
  :Báo lỗi đăng nhập;
endif
|Khách|
:Vào trang cá nhân hoặc sửa lại thông tin;
stop
@enduml
