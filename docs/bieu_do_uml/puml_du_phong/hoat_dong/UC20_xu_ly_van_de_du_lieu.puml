@startuml UC20_hoat_dong
' UC20 — Xử lý vấn đề dữ liệu
' API: GET /admin/issues; POST | DELETE /admin/issues/resolve
skinparam shadowing false
start
|Quản trị viên|
:Mở danh sách vấn đề;
|Hệ thống|
if (Đã đăng nhập quản trị?) then (có)
  |Hệ thống|
  :Tải danh sách vấn đề;
  |Quản trị viên|
  :Xem chi tiết, đánh dấu đã xử lý;
  |Hệ thống|
  :Đánh dấu đã xử lý;
  |Quản trị viên|
  :Xem danh sách đã cập nhật;
  stop
else (không)
  :Chuyển về trang đăng nhập quản trị;
  stop
endif
@enduml
