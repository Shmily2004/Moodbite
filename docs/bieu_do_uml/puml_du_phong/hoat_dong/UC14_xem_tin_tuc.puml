@startuml UC14_hoat_dong
' UC14 — Xem tin tức
' API: GET /api/v1/posts, GET /api/v1/posts/{slug}
skinparam shadowing false
start
|Khách hàng|
:Mở trang tin tức;
|Hệ thống|
if (Đã đăng nhập?) then (có)
  |Hệ thống|
  :Tải bài đã công khai;
  |Khách hàng|
  :Chọn một bài;
  |Hệ thống|
  :Tải nội dung bài;
  |Khách hàng|
  :Đọc bài;
  stop
else (không)
  :Chuyển tới trang đăng nhập;
  stop
endif
@enduml
