    "/api/v1/moods": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Moods",
        "description": "Các mood dùng cho lối tắt `mood` của POST /search.\n\nĐề án ưu tiên tìm kiếm bằng câu tự do; danh sách này chỉ phục vụ nút bấm nhanh.",
        "operationId": "moods_api_v1_moods_get",
        "responses": {
          "200": {
