@startuml UC21_hoat_dong
' UC21 — Xem xét báo đóng cửa
' API: GET /admin/closure-reports; POST /admin/restaurants/{id}/closure-reports/clear
skinparam shadowing false
start
|Quản trị viên|
:Mở danh sách quán bị báo;
|Hệ thống|
if (Đã đăng nhập quản trị?) then (có)
  |Hệ thống|
  :Tải danh sách quán bị báo;
  |Quản trị viên|
  :Kiểm tra và quyết định;
  if (Quán thực sự đã đóng cửa?) then (có)
    :Ẩn quán, ghi nhật ký;
  else (không)
    :Gỡ các lượt báo của quán;
  endif
  stop
else (không)
  :Chuyển về trang đăng nhập quản trị;
  stop
endif
@enduml
