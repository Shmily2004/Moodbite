# MoodBite — mẫu biến môi trường.
#
# CÁCH DÙNG: copy file này thành `.env.local` rồi điền giá trị thật vào BẢN COPY.
#
# ⚠️ TUYỆT ĐỐI KHÔNG điền giá trị thật vào chính file này. `.env.example` CÓ trong git —
#    điền secret vào đây là công khai nó cho bất kỳ ai xem được kho mã. `.env.local` thì
#    nằm trong .gitignore nên an toàn. (Lỗi này đã xảy ra thật ngày 2026-08-22.)
#
# Từ 2026-08-22 backend TỰ ĐỌC `.env.local` lúc khởi động (xem
# `src/infrastructure/config/dotenv.py`), không phải tự đặt biến trong shell nữa.
# Biến đã đặt sẵn trong shell vẫn THẮNG file — để máy chủ thật không bị file lẻ ghi đè.

# ============================================================================
# KHO LƯU TRỮ
# ============================================================================
# 'csv' (mặc định) = CHỈ ĐỌC, đủ cho app người dùng cuối.
# 'sqlite'          = ghi được, BẮT BUỘC nếu muốn dùng trang quản trị.
#                     Dựng CSDL trước: python scripts/build_sqlite.py
MOODBITE_STORAGE=csv

# ============================================================================
# TRANG QUẢN TRỊ — cả 3 biến đều BẮT BUỘC
# ============================================================================
# FAIL-CLOSED: thiếu bất kỳ biến nào thì MỌI endpoint /api/v1/admin/* trả 503.
# Đây là CÓ CHỦ ĐÍCH — trang quản trị không bao giờ được mặc định thành công khai.
#
# Sinh cả 3 giá trị bằng một lệnh:
#     python scripts/make_admin_password.py
#
MOODBITE_ADMIN_USER=
# Chuỗi PBKDF2 dạng: pbkdf2_sha256$600000$<salt>$<hash>
# KHÔNG BAO GIỜ đặt mật khẩu thô vào đây.
MOODBITE_ADMIN_PASSWORD_HASH=
# Khoá ký token. Đổi giá trị này sẽ làm mọi token đang dùng hết hiệu lực ngay.
MOODBITE_ADMIN_SECRET=
# Token sống bao lâu (giây). Mặc định 3600 = 1 giờ.
MOODBITE_ADMIN_TOKEN_TTL=3600

# ============================================================================
# TÀI KHOẢN NGƯỜI DÙNG CUỐI — /api/v1/auth/*
# ============================================================================
# FAIL-CLOSED giống trang quản trị: thiếu secret thì /api/v1/auth/* trả 503 và
# KHÔNG ai đăng ký/đăng nhập được. Cố tình không tự sinh secret ngẫu nhiên lúc chạy —
# làm vậy thì mỗi lần khởi động lại là mọi người bị đăng xuất.
#
# Sinh chuỗi ngẫu nhiên:
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠️ PHẢI KHÁC MOODBITE_ADMIN_SECRET. Dùng chung thì token người dùng và token admin
# ký bằng cùng một khoá — mất đi lớp ngăn cách cuối cùng giữa hai loại quyền.
MOODBITE_AUTH_SECRET=
# Token sống bao lâu (giây). Mặc định 86400 = 24 giờ.
# Ngắn hơn thông lệ vì CHƯA có cơ chế thu hồi token: đăng xuất chỉ xoá token ở client.
MOODBITE_AUTH_TOKEN_TTL=86400
# Nơi lưu tài khoản. MẶC ĐỊNH ĐÃ ĐÚNG, chỉ đổi khi thật sự cần.
# ⚠️ File này là DỮ LIỆU GỐC — mất là mất hẳn, không dựng lại được từ đâu. Khác hẳn
# moodbite.db (kho quán) vốn dựng lại được bằng scripts/build_sqlite.py.
# MOODBITE_USERS_DB=

# ---------------------------------------------------------------------------
# QUÊN MẬT KHẨU — gửi thư qua SMTP (MIỄN PHÍ, không cần thẻ thanh toán)
# ---------------------------------------------------------------------------
# Thiếu bất kỳ dòng nào trong nhóm SMTP thì tính năng TẮT hẳn và
# POST /api/v1/auth/forgot-password trả 503 kèm hướng dẫn — KHÔNG giả vờ "đã gửi".
#
# CÁCH LẤY MẬT KHẨU ỨNG DỤNG CỦA GMAIL (không dùng mật khẩu Gmail thật):
#   1. Bật xác minh 2 bước: https://myaccount.google.com/security
#   2. Tạo mật khẩu ứng dụng: https://myaccount.google.com/apppasswords
#   3. Dán chuỗi 16 ký tự vào MOODBITE_SMTP_PASSWORD (có khoảng trắng cũng được,
#      code tự bỏ). Mật khẩu này thu hồi riêng được và KHÔNG mở được hộp thư.
# Hạn mức Gmail ~500 thư/ngày — thừa cho demo. Không cần tên miền, không cần thẻ.
MOODBITE_SMTP_HOST=smtp.gmail.com
MOODBITE_SMTP_PORT=587
MOODBITE_SMTP_USER=
MOODBITE_SMTP_PASSWORD=
# Địa chỉ hiện ở ô "From". Bỏ trống thì dùng luôn MOODBITE_SMTP_USER.
MOODBITE_SMTP_FROM=

# Secret RIÊNG để ký token đặt lại mật khẩu. Bỏ trống thì lui về MOODBITE_AUTH_SECRET,
# nhưng nên tách: token này nằm trong hộp thư — nơi dễ lộ hơn hẳn trình duyệt.
# Sinh chuỗi: python -c "import secrets; print(secrets.token_hex(32))"
MOODBITE_RESET_SECRET=
# Đường dẫn trong thư sống bao lâu (giây). Mặc định 1800 = 30 phút.
MOODBITE_RESET_TOKEN_TTL=1800

# Địa chỉ GỐC của frontend, dùng để dựng link trong thư:
#   <MOODBITE_APP_URL>/dat-lai-mat-khau?token=...
# Chạy máy mình thì để nguyên; deploy thật thì đổi thành tên miền thật, nếu không
# người dùng bấm link trong thư sẽ vào localhost của chính họ.
MOODBITE_APP_URL=http://localhost:5173

# ============================================================================
# TÍN HIỆU NGỮ CẢNH
# ============================================================================
# Bật thời tiết qua Open-Meteo (miễn phí, không cần API key).
# Tắt mặc định vì bật lên là mỗi lượt tìm kiếm phụ thuộc mạng.
# API lỗi KHÔNG làm hỏng tìm kiếm — hệ thống lui về ngữ cảnh trung lập.
MOODBITE_ENABLE_WEATHER=

# ============================================================================
# ĐƯỜNG DẪN DỮ LIỆU (để trống = dùng mặc định trong infrastructure/config/settings.py)
# ============================================================================
# MOODBITE_RESTAURANTS_CSV=
# MOODBITE_RESTAURANTS_DB=
# MOODBITE_RESTAURANT_DETAILS_JSON=
# MOODBITE_DISH_KNOWLEDGE_JSON=
# MOODBITE_INTERACTIONS=

# ============================================================================
# CORS
# ============================================================================
# Danh sách origin ngăn cách bằng dấu phẩy. '*' chỉ nên dùng khi phát triển.
# Khi deploy thật nên ghi rõ: http://localhost:5173,http://localhost:5174
MOODBITE_CORS_ORIGINS=*

# ============================================================================
# ĐẶT BIẾN TRÊN POWERShell 5.1 (Windows) — mỗi lệnh MỘT DÒNG, không dùng &&
# ============================================================================
#   $env:MOODBITE_STORAGE = "sqlite"
#   $env:MOODBITE_ADMIN_USER = "admin"
#   $env:MOODBITE_ADMIN_PASSWORD_HASH = "pbkdf2_sha256$600000$..."
#   $env:MOODBITE_ADMIN_SECRET = "..."
#
# Kiểm lại đã đặt đúng chưa:
#   python scripts/check_permissions.py
