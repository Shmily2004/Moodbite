      "SearchRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "UUID v4 do client tự sinh và lưu ở localStorage. Không có tài khoản người dùng (SRS mục 8, Won't-have)."
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "default": 21.0285
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "default": 105.8542
          },
          "query_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Text",
            "description": "Nhu cầu bằng câu tự nhiên, VD \"quán lẩu ấm cúng gần đây\"."
          },
          "mood": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mood",
            "description": "Lối tắt tuỳ chọn thay cho query_text. Hợp lệ: ['happy', 'sad', 'excited', 'relaxed']"
          },
          "max_distance_km": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Distance Km",
            "description": "null = tắt lọc theo khoảng cách.",
            "default": 10.0
          },
          "dietary_restrictions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dietary Restrictions",
            "description": "vegetarian | vegan | halal | kosher | gluten_free. Dữ liệu rất thưa - quán chưa khai báo vẫn được giữ lại."
          },
          "opening_hours_constraint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opening Hours Constraint",
            "description": "\"now\" hoặc \"HH:mm\". Quán chưa có dữ liệu giờ vẫn giữ lại."
          },
          "district": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "District",
            "description": "Đơn vị hành chính, VD \"Phường Cầu Giấy\". Không khớp quán nào -> bỏ lọc."
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "SearchRequest"
      },
