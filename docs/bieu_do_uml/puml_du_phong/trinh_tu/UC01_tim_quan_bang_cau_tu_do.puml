@startuml UC01_trinh_tu
' UC01 — Tìm quán bằng câu tự do
' API: POST /api/v1/search
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Khách" as KH
boundary "UI_GiaoDienWeb" as UI
control "Ctrl_HeThongXuLy" as CTRL
entity "Ent_CoSoDuLieu" as DB

KH -> UI : 1. Nhập câu tìm kiếm
UI -> CTRL : 2. POST /search {truy vấn, vị trí, bán kính}
CTRL -> DB : 3. Lấy quán đang bật
DB --> CTRL : 4. Danh sách quán
note over CTRL : 5. Bỏ dấu, khớp từ nguyên vẹn, xếp hạng
alt có quán khớp
  CTRL --> UI : 6a. Danh sách quán + gợi ý món
  UI --> KH : 7a. Hiển thị kết quả
else khác
  CTRL --> UI : 6b. Danh sách rỗng + warnings
  UI --> KH : 7b. Thông báo không có quán khớp
end
@enduml
