{
  // Chỉ khai những gì KHÁC với `tsconfig.base.json`: app này chạy trên trình duyệt
  // nên cần DOM + JSX, và cần alias trỏ tới mã nguồn của package dùng chung.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "node"],
    // KHÔNG dùng `baseUrl` — TypeScript đã đánh dấu deprecated (sẽ ngừng hoạt động ở
    // TS 7.0). Từ TS 5.x, `paths` chạy được mà không cần `baseUrl`: đường dẫn được
    // tính tương đối với CHÍNH file tsconfig này.
    "paths": {
      "@/*": ["./src/*"],
      "@moodbite/api-client": ["../../packages/api-client/src/index.ts"],
      "@moodbite/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
