{
  // Giống `apps/client` nhưng KHÔNG có vitest (app admin chưa có test) và không có
  // Leaflet. Kế thừa toàn bộ tuỳ chọn chung từ tsconfig.base.json.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@moodbite/api-client": ["../../packages/api-client/src/index.ts"],
      "@moodbite/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
