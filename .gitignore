# .gitignore (resaved as UTF-8 without BOM)
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script, and contain the bin/
#  binary and any libraries it needs in a self-contained format.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.metric
.pytest_cache/
pytestdebug.log

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or binary, you should probably not check in the .python-version file.
#   For a top-level application, however, you may want to.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to check Pipfile.lock into source control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having cross-platform versions, pipenv may install dependencies that don't work, or even
#   fail to install them.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
# poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
# pdm.lock

# virtualenv
.venv/
venv/
ENV/
env/

# Biến môi trường - CHỨA API KEY, không bao giờ được commit.
# .env.example thì ngược lại: PHẢI commit để người khác biết cần khai báo biến gì.
.env
.env.local
.env.*.local
!.env.example

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Project Specific
config/secrets.yaml
data_pipeline/data_raw/
data_pipeline/data_cleaned/*
# Ngoại lệ: dataset_moodbite_features.csv là file đã xử lý (4170 dòng, ~1MB), KHÔNG phải
# raw data. Cần commit để bản deploy live (Railway/FastAPI) có data thật để chạy - server
# deploy không tự chạy được data_pipeline (không có data_raw/*.json - dữ liệu cào từ Apify/OSM
# vẫn giữ nguyên tắc không commit).
!data_pipeline/data_cleaned/dataset_moodbite_features.csv
# Cùng lý do: restaurant_details.json (~1MB) chứa giá/review/ảnh cho GET /api/restaurant/
# {place_id}. Không commit thì endpoint này chết trên Railway dù local vẫn chạy tốt.
# Đã cắt còn 10 review + 12 ảnh mỗi quán để file không vượt giới hạn 100MB/file của GitHub
# khi cào đủ 4170 quán (xem MAX_REVIEWS_PER_PLACE trong feature_engineering.py).
!data_pipeline/data_cleaned/restaurant_details.json
*.pth
*.pt
*.onnx
*.glb
*.ckpt
*.weights
*.bin
outputs/
runs/
test_images/
models/
committed.csv
# Dữ liệu tương tác người dùng sinh ra lúc chạy (nhãn cho mô hình xếp hạng).
# Không commit: mỗi máy/lần chạy sẽ khác nhau và file chỉ lớn dần.
data_pipeline/data_cleaned/interactions.jsonl

# Cache theo o cua Overpass - sinh lai duoc, chi de tang toc chay lai.
data_pipeline/data_raw/.osm_cache/
# Log chay thu thap du lieu
harvest.log

# CSDL SQLite dung tu CSV bang `python scripts/build_sqlite.py` - SINH LAI DUOC,
# khong commit (4MB va se lech voi CSV moi lan pipeline chay lai).
data_pipeline/data_cleaned/*.db

