        "title": "AdminRestaurantSummary",
        "description": "Một quán nhìn từ phía quản trị.\n\n`rating`/`reviews_count`/`price` để None khi CHƯA CÓ DỮ LIỆU — không đổi thành 0\nhay chuỗi rỗng, vì admin cần phân biệt \"thiếu dữ liệu\" với \"giá trị bằng 0\"."
      },
      "AdminUpdateRestaurantRequest": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "cuisine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
