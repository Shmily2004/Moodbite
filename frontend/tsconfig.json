{
  // Project bao phủ phần monorepo NẰM NGOÀI `apps/client`: các package dùng chung và
  // file cấu hình ở gốc `frontend/`.
  //
  // Không có file này thì IDE không tìm được tsconfig cho `packages/**` và
  // `steiger.config.ts` — xem lời giải thích ở `tsconfig.base.json`.
  //
  // `apps/client` CÓ tsconfig riêng (cần thêm DOM + JSX + alias), nên cố ý KHÔNG
  // include ở đây để hai project không chồng lấn.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // packages/ui có component React (.tsx) — cần JSX để kiểm kiểu đúng.
    "jsx": "react-jsx",
    // Có component chạm DOM (window, KeyboardEvent, HTMLButtonElement).
    "lib": ["ES2022", "DOM"],
    // Khu quản trị (packages/admin) dùng alias nội bộ `@admin/*` như app người dùng.
    "paths": {
      "@admin/*": ["./packages/admin/src/*"]
    }
  },
  // packages/admin dùng `import.meta.env` (kiểu của Vite): nó được kiểm bởi tsconfig của app
  // người dùng (apps/client), nơi có đủ kiểu Vite. Ở đây loại ra để không báo lỗi giả.
  "include": ["packages/**/*.ts", "packages/**/*.d.ts", "steiger.config.ts"],
  "exclude": ["packages/admin"]
}
