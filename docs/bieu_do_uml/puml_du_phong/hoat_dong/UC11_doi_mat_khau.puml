@startuml UC11_hoat_dong
' UC11 — Đổi mật khẩu
' API: POST /api/v1/auth/change-password
skinparam shadowing false
start
|Khách hàng|
:Nhập mật khẩu cũ và mật khẩu mới;
|Hệ thống|
if (Đã đăng nhập?) then (có)
  |Hệ thống|
  :Kiểm tra mật khẩu cũ và cập nhật mật khẩu mới;
  if (Phiên hợp lệ và mật khẩu cũ đúng?) then (có)
    :Cập nhật mật khẩu mới, thu hồi phiên ở các máy khác;
  else (không)
    :Báo lỗi;
  endif
  stop
else (không)
  :Chuyển tới trang đăng nhập;
  stop
endif
@enduml
