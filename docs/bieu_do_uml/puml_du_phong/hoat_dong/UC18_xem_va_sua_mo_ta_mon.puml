@startuml UC18_hoat_dong
' UC18 — Xem và sửa mô tả món
' API: GET /admin/dishes, GET/PATCH /admin/dishes/{id}
skinparam shadowing false
start
|Quản trị viên|
:Mở món, bấm Sửa mô tả;
|Hệ thống|
if (Đã đăng nhập quản trị?) then (có)
  :Nhập mô tả, bấm Lưu (hoặc Gỡ bản sửa);
  |Hệ thống|
  :Lưu bản sửa mô tả, ghi nhật ký;
  if (Mô tả hợp lệ?) then (có)
    :Lưu bản sửa, ghi nhật ký;
  else (không)
    :Trả lỗi 400, không ghi gì;
  endif
  |Quản trị viên|
  :Xem mô tả mới;
  stop
else (không)
  :Chuyển về trang đăng nhập quản trị;
  stop
endif
@enduml
