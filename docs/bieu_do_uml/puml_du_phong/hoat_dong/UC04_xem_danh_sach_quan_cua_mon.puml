@startuml UC04_hoat_dong
' UC04 — Xem danh sách quán của món
' API: GET /api/v1/dishes/{id}/restaurants
skinparam shadowing false
start
|Khách hàng|
:Bấm xem quán bán món này;
|Hệ thống|
if (Đã đăng nhập?) then (có)
  |Hệ thống|
  :Tra các quán khớp món theo chỉ mục;
  if (Có quán trong bán kính?) then (có)
    :Xếp quán theo mức phù hợp;
  else (không)
    :Nới bán kính, lấy quán gần nhất, CẢNH BÁO khoảng cách;
  endif
  if (Đã đăng nhập và có vị trí của bạn?) then (có)
    :Hiển thị khoảng cách từ vị trí của bạn đến quán;
  else (không)
    :Ẩn khoảng cách, chỉ hiển thị tên và địa chỉ quán;
  endif
  |Khách hàng|
  :Xem danh sách quán;
  stop
else (không)
  :Chuyển tới trang đăng nhập;
  stop
endif
@enduml
