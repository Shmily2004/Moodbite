@startuml UC11_trinh_tu
' UC11 — Đổi mật khẩu
' API: POST /api/v1/auth/change-password
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Khách" as KH
boundary "UI_GiaoDienWeb" as UI
control "Ctrl_HeThongXuLy" as CTRL
entity "Ent_CoSoDuLieu" as DB
entity "Ent_TaiKhoan" as TK

KH -> UI : 1. Nhập mật khẩu cũ và mới
UI -> CTRL : 2. POST /auth/change-password
CTRL -> TK : 3. Kiểm tra phiên và mật khẩu cũ
alt phiên hợp lệ và mật khẩu cũ đúng
  CTRL -> TK : 4a. Cập nhật mật khẩu mới
  CTRL --> UI : 5a. 200 OK
  UI --> KH : 6a. Đã đổi mật khẩu
else khác
  CTRL --> UI : 4b. 401 hoặc 400
  UI --> KH : 5b. Báo lỗi
end
@enduml
