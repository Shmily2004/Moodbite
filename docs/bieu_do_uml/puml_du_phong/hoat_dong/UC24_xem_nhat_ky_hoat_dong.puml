@startuml UC24_hoat_dong
' UC24 — Xem nhật ký hoạt động
' API: GET /api/v1/admin/activity
skinparam shadowing false
start
|Quản trị viên|
:Mở nhật ký;
|Hệ thống|
if (Đã đăng nhập quản trị?) then (có)
  |Hệ thống|
  :Tải nhật ký hoạt động;
  |Quản trị viên|
  :Lọc và xem các thao tác;
  stop
else (không)
  :Chuyển về trang đăng nhập quản trị;
  stop
endif
@enduml
