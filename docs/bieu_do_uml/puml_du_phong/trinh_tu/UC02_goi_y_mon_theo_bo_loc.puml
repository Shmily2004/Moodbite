@startuml UC02_trinh_tu
' UC02 — Gợi ý món theo bộ lọc
' API: POST /api/v1/dishes/suggest
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Khách" as KH
boundary "UI_GiaoDienWeb" as UI
control "Ctrl_HeThongXuLy" as CTRL
entity "Ent_CoSoDuLieu" as DB

KH -> UI : 1. Chọn tâm trạng, bữa ăn, bán kính
UI -> CTRL : 2. POST /dishes/suggest
CTRL -> DB : 3. Lấy danh mục món đang bật và chỉ mục món-quán
DB --> CTRL : 4. Danh sách món + số quán
note over CTRL : 5. Suy ngữ cảnh (giờ, thời tiết) rồi xếp hạng món
alt có món phù hợp
  CTRL --> UI : 6a. Danh sách món + warnings
  UI --> KH : 7a. Hiển thị lưới món
else khác
  CTRL --> UI : 6b. Danh sách rỗng
  UI --> KH : 7b. Thông báo không khớp, gợi ý bỏ bớt bộ lọc
end
@enduml
