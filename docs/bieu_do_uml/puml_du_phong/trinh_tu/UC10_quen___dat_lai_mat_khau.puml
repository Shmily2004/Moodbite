@startuml UC10_trinh_tu
' UC10 — Quên / đặt lại mật khẩu
' API: POST /api/v1/auth/forgot-password; POST /auth/reset-password
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Khách" as KH
boundary "UI_GiaoDienWeb" as UI
control "Ctrl_HeThongXuLy" as CTRL
entity "Ent_CoSoDuLieu" as DB
entity "Ent_TaiKhoan" as TK

KH -> UI : 1. Nhập email quên mật khẩu
UI -> CTRL : 2. POST /auth/forgot-password
CTRL -> TK : 3. Tạo mã đặt lại
CTRL --> UI : 4. 200 OK (không lộ email có tồn tại hay không)
KH -> UI : 5. Nhập mã và mật khẩu mới
UI -> CTRL : 6. POST /auth/reset-password
CTRL -> TK : 7. Kiểm tra mã, cập nhật mật khẩu
CTRL --> UI : 8. 200 OK
UI --> KH : 9. Mời đăng nhập lại
@enduml
