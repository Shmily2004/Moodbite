@startuml UC02_hoat_dong
' UC02 — Gợi ý món theo bộ lọc
' API: POST /api/v1/dishes/suggest
skinparam shadowing false
start
|Khách hàng|
:Chọn bộ lọc: tâm trạng, bữa ăn, cách chế biến, khoảng cách;
|Hệ thống|
if (Đã đăng nhập?) then (có)
  |Hệ thống|
  :Tính gợi ý món theo bộ lọc;
  if (Có món phù hợp?) then (có)
    :Hiển thị lưới món kèm cảnh báo món bị ẩn;
  else (không)
    :Thông báo không khớp, gợi ý bỏ bớt bộ lọc;
  endif
  |Khách hàng|
  :Chọn một món hoặc bỏ bớt bộ lọc;
  stop
else (không)
  :Chuyển tới trang đăng nhập;
  stop
endif
@enduml
