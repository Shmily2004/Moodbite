@startuml UC13_trinh_tu
' UC13 — Quản lý bộ sưu tập
' API: /api/v1/me/collections (GET, POST, PATCH, DELETE) và /items
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Khách" as KH
boundary "UI_GiaoDienWeb" as UI
control "Ctrl_HeThongXuLy" as CTRL
entity "Ent_CoSoDuLieu" as DB
entity "Ent_TaiKhoan" as TK

KH -> UI : 1. Tạo hoặc đổi tên bộ sưu tập
UI -> CTRL : 2. POST | PATCH /me/collections
CTRL -> TK : 3. Ghi bộ sưu tập
CTRL --> UI : 4. Kết quả
UI --> KH : 5. Hiển thị bộ sưu tập mới
@enduml
